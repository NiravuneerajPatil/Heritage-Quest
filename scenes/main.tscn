[gd_scene format=3 uid="uid://c8luqqi401h0b"]

[sub_resource type="GDScript" id="GDScript_o5qli"]
resource_name = "main_menu"
script/source = "extends Control

@onready var main_buttons: VBoxContainer = $MarginContainer/VBoxContainer/MainButtons
@onready var settings_panel: PanelContainer = $SettingsPanel

# Node references for buttons (adjust paths if your scene hierarchy differs)
@onready var play_button: Button = $MarginContainer/VBoxContainer/MainButtons/PlayButton
@onready var settings_button: Button = $MarginContainer/VBoxContainer/MainButtons/SettingsButton
@onready var quit_button: Button = $MarginContainer/VBoxContainer/MainButtons/QuitButton
@onready var back_button: Button = %BackButton if has_node(\"%BackButton\") else $SettingsPanel/VBoxContainer/BackButton

func _ready() -> void:
	if settings_panel:
		settings_panel.hide()

	# Connect button signals programmatically
	if play_button and not play_button.pressed.is_connected(_on_play_button_pressed):
		play_button.pressed.connect(_on_play_button_pressed)
	if settings_button and not settings_button.pressed.is_connected(_on_settings_button_pressed):
		settings_button.pressed.connect(_on_settings_button_pressed)
	if quit_button and not quit_button.pressed.is_connected(_on_quit_button_pressed):
		quit_button.pressed.connect(_on_quit_button_pressed)
	if back_button and not back_button.pressed.is_connected(_on_back_from_settings_pressed):
		back_button.pressed.connect(_on_back_from_settings_pressed)

func _on_play_button_pressed() -> void:
	print(\"Play button pressed. Loading level...\")
	var err = get_tree().change_scene_to_file(\"res://scenes/levels/Level1_RedFort.tscn\")
	if err != OK:
		push_error(\"Failed to load scene at 'res://scenes/levels/Level1_RedFort.tscn'. Error code: %d\" % err)

func _on_settings_button_pressed() -> void:
	main_buttons.hide()
	settings_panel.show()

func _on_quit_button_pressed() -> void:
	get_tree().quit()

func _on_back_from_settings_pressed() -> void:
	settings_panel.hide()
	main_buttons.show()

# Audio Volume Adjusters using AudioServer
func _on_music_slider_value_changed(value: float) -> void:
	var bus_idx = AudioServer.get_bus_index(\"Music\")
	if bus_idx != -1:
		AudioServer.set_bus_volume_db(bus_idx, linear_to_db(value))

func _on_sfx_slider_value_changed(value: float) -> void:
	var bus_idx = AudioServer.get_bus_index(\"SFX\")
	if bus_idx != -1:
		AudioServer.set_bus_volume_db(bus_idx, linear_to_db(value))
"

