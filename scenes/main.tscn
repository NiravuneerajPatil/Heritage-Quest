[sub_resource type="GDScript" id="GDScript_o5qli"]
resource_name = "main_menu"
script/source = "extends Control

# Heritage Quest - Main Menu & Settings Overlay Script

@onready var settings_layer: CanvasLayer = $SettingsLayer
@onready var color_rect: ColorRect = $SettingsLayer/ColorRect
@onready var center_container: CenterContainer = $SettingsLayer/ColorRect/CenterContainer
@onready var panel_container: PanelContainer = $SettingsLayer/ColorRect/CenterContainer/PanelContainer

@onready var play_button: Button = $MarginContainer/VBoxContainer/MainButtons/PlayButton
@onready var settings_button: Button = $MarginContainer/VBoxContainer/MainButtons/SettingsButton
@onready var quit_button: Button = $MarginContainer/VBoxContainer/MainButtons/QuitButton
@onready var back_button: Button = $SettingsLayer/ColorRect/CenterContainer/PanelContainer/VBoxContainer/BackButton

@onready var master_slider: HSlider = $SettingsLayer/ColorRect/CenterContainer/PanelContainer/VBoxContainer/HBoxContainer/HSlider if has_node(\"SettingsLayer/ColorRect/CenterContainer/PanelContainer/VBoxContainer/HBoxContainer/HSlider\") else null
@onready var music_slider: HSlider = $SettingsLayer/ColorRect/CenterContainer/PanelContainer/VBoxContainer/HBoxContainer2/HSlider if has_node(\"SettingsLayer/ColorRect/CenterContainer/PanelContainer/VBoxContainer/HBoxContainer2/HSlider\") else null

func _ready() -> void:
	# Hide Settings panel by default
	if settings_layer:
		settings_layer.hide()

	# Enforce layout presets at runtime
	if color_rect:
		color_rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
		color_rect.color = Color(0.05, 0.05, 0.08, 0.85)

	if center_container:
		center_container.use_top_left = false
		center_container.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)

	_apply_heritage_style()

	# Connect Main Menu Buttons
	if play_button: play_button.pressed.connect(_on_play_pressed)
	if settings_button: settings_button.pressed.connect(_on_settings_pressed)
	if quit_button: quit_button.pressed.connect(_on_quit_pressed)
	if back_button: back_button.pressed.connect(_on_back_pressed)

	# Audio GameManager Sync
	var gm = get_node_or_null(\"/root/GameManager\")
	if gm:
		if master_slider: _setup_slider(master_slider, gm.master_volume, func(v): gm.set_master_volume(v))
		if music_slider: _setup_slider(music_slider, gm.music_volume, func(v): gm.set_music_volume(v))

func _apply_heritage_style() -> void:
	if panel_container:
		panel_container.custom_minimum_size = Vector2(550, 360)
		var style = StyleBoxFlat.new()
		style.bg_color = Color(0.12, 0.11, 0.15, 0.96) # Dark Slate
		style.border_color = Color(0.88, 0.65, 0.18, 1.0) # Gold Accent
		style.set_border_width_all(3)
		style.set_corner_radius_all(10)
		style.content_margin_left = 30
		style.content_margin_right = 30
		style.content_margin_top = 20
		style.content_margin_bottom = 20
		panel_container.add_theme_stylebox_override(\"panel\", style)

func _setup_slider(slider: HSlider, val: float, callback: Callable) -> void:
	slider.min_value = 0.0
	slider.max_value = 1.0
	slider.step = 0.05
	slider.value = val
	slider.custom_minimum_size.x = 220
	slider.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	if not slider.value_changed.is_connected(callback):
		slider.value_changed.connect(callback)

func _on_play_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/levels/Level1_RedFort.tscn\")

func _on_settings_pressed() -> void:
	if settings_layer:
		settings_layer.show()

func _on_back_pressed() -> void:
	if settings_layer:
		settings_layer.hide()

func _on_quit_pressed() -> void:
	get_tree().quit()
"

